# Required - Resend API key (server-side only, never expose with a NEXT_PUBLIC_ prefix)
RESEND_API_KEY=your_resend_api_key

# Required - recipient inbox for new contact enquiries
TO_EMAIL=your-company-email@example.com

# Optional - verified Resend sender, e.g. "ParamShree <no-reply@yourdomain.com>".
# When unset, Resend's trial sender (onboarding@resend.dev) is used, which only
# delivers to the Resend account's own address. Set this after verifying your
# domain at https://resend.com/domains.
RESEND_FROM_EMAIL=

# Optional integrations (already supported by /api/enquiry)
# GOOGLE_SHEETS_WEBHOOK_URL=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# ENQUIRY_WHATSAPP_TO=
